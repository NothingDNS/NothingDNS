<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NothingDns.Sdk</RootNamespace>
    <AssemblyName>NothingDns.Sdk</AssemblyName>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NothingDns.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>NothingDNS</Authors>
    <Description>A dependency-free C# client for the NothingDNS management API: zones, records, cache, runtime config, ACL, blocklists, RPZ, DNSSEC, upstreams, GeoIP, clustering, dashboard and metrics.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Examples/QuickStart.cs is a standalone console program with its own project
    (Examples/QuickStart.csproj). Exclude it here so the library build stays clean.
  -->
  <ItemGroup>
    <Compile Remove="Examples/**" />
  </ItemGroup>

</Project>
